# What PortableKit's release scripts need to know about this port
# (portablekit/scripts/release_macos.sh; see docs/RELEASING.md).
RELEASE_NAME=Olympus
RELEASE_SLUG=olympus
RELEASE_TARGET=OlympusNative
RELEASE_APP_ID=io.olympus.Olympus
RELEASE_SUMMARY="Play God of War: Chains of Olympus natively from your own disc image"
RELEASE_URL=https://github.com/arnaldolima1/gow-chains-of-olympus-pc
# The game loads no code overlays.
RELEASE_OVERLAYS=0
# Names that are this game's data and must never be packed (lower case).
RELEASE_GAME_NAMES="uces00842* eboot.* boot.bin *.iso"
